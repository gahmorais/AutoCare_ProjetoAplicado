<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de backup para Android 12+ (API 31).

   Os arquivos vinham como os templates comentados do Android Studio, o que
   significa "copie tudo": as SharedPreferences do Firebase Auth, onde fica o
   refresh token persistido, iam junto no backup em nuvem e na transferencia
   entre aparelhos. Quem restaurasse o backup herdava a sessao autenticada.

   Os dados do app moram no Firebase e sao recuperados no proximo login, entao
   nao ha nada local que valha a pena preservar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="com.google.firebase.auth.api.Store.xml" />
        <exclude
            domain="sharedpref"
            path="com.google.android.gms.appid.xml" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="sharedpref"
            path="com.google.firebase.auth.api.Store.xml" />
        <exclude
            domain="sharedpref"
            path="com.google.android.gms.appid.xml" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
