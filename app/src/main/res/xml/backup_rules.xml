<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de backup para Android 9-11. O porque de cada item esta em
   data_extraction_rules.xml, que vale do Android 12 em diante - mantenha os
   dois iguais (BackupRulesTest confere).
-->
<full-backup-content>
    <include domain="database" path="autocare.db" />
    <include domain="database" path="autocare.db-wal" />
    <include domain="database" path="autocare.db-shm" />
    <include domain="file" path="images/" />
    <include domain="file" path="datastore/" />
</full-backup-content>
