<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de backup para dispositivos anteriores ao Android 12.
   Ver o comentario em data_extraction_rules.xml: o objetivo e manter o token
   de sessao do Firebase Auth fora de qualquer backup.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="com.google.firebase.auth.api.Store.xml" />
    <exclude
        domain="sharedpref"
        path="com.google.android.gms.appid.xml" />
    <exclude domain="database" />
    <exclude domain="file" />
</full-backup-content>
