<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A foto e opcional e o cropper tambem aceita a galeria; exigir camera
         apenas bloqueava a instalacao em aparelhos sem ela. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Sem esta permissao declarada, o pedido em runtime e negado pelo sistema
         sem nem exibir o dialogo, e nenhuma notificacao aparece no Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Necessaria para reagendar os alarmes, que o sistema descarta no reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AutoCareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_autocare_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoCare"
        tools:targetApi="31">

        <receiver
            android:name=".data.notifications.NotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- O AlarmManager descarta todos os alarmes no reboot; este receiver
             reagenda as notificacoes pendentes. Precisa ser exported para
             receber o broadcast do sistema. -->
        <receiver
            android:name=".data.notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Detalhe do veiculo, minha conta e formulario de manutencao deixaram
             de ser Activities e viraram destinos do NavHost da MainActivity. -->
        <activity android:name=".ui.activities.main_screen.MainActivity" />
        <activity android:name=".ui.activities.register_screen.RegisterActivity" />
        <activity
            android:name=".ui.activities.login_screen.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AutoCare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat" />
    </application>

</manifest>