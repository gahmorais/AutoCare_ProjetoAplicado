{
  "rules": {
    ".read": false,
    ".write": false,

    "Usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['id']) && newData.child('id').val() === $uid"
      }
    },

    "vehicles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$vehicleId": {
          ".validate": "newData.hasChildren(['id'])"
        }
      }
    },

    "lista-servicos": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
