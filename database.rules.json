{
  "rules": {
    ".read": false,
    ".write": false,

    "Usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "vehicles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "lista-servicos": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
